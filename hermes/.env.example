# Example secrets for the hermes package.
# Copy the values you need to ~/.hermes/.env (chmod 0600, never committed).
# Hermes reads secrets from there; .hermes/config.yaml only holds
# non-secret settings and ${VAR} references.

# OpenCode as LLM provider (pick one; see model.provider in the yaml).
# Go: $10/mo subscription for curated open models, key from the OpenCode console.
OPENCODE_GO_API_KEY=
# Zen: pay-as-you-go curated models.
# OPENCODE_ZEN_API_KEY=

# MCP secrets referenced by the commented examples in the yaml.
# HASS_MCP_URL=
# HASS_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
