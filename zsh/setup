#!/bin/bash

source "$DOTFILES_ROOT/print_helper"
source "$DOTFILES_ROOT/helpers"

mkdir -p "$HOME/code/"

info "Setting up zsh package"
run_required_step "Stowing zsh package" stow zsh

# Make zsh the login shell (Linux servers, e.g. Proxmox homelab).
# Skipped when already set; runs via run_optional_step upstream so a
# password prompt failure never breaks the install.
if is_linux; then
  ZSH_PATH="$(command -v zsh)"
  if [ -n "$ZSH_PATH" ] && [ "$SHELL" != "$ZSH_PATH" ]; then
    info "Setting $ZSH_PATH as default shell"
    grep -qxF "$ZSH_PATH" /etc/shells || echo "$ZSH_PATH" | sudo tee -a /etc/shells > /dev/null
    if ! chsh -s "$ZSH_PATH"; then
      warning "Could not change login shell with 'chsh' (chsh authenticates via PAM, not via sudo, so it fails with 'PAM: Authentication failure' on accounts with no login password: 'passwd -S' shows L, common on cloud-init VMs with passwordless sudo)."
      warning "To fix manually, run:"
      warning "  grep -qxF $ZSH_PATH /etc/shells || echo $ZSH_PATH | sudo tee -a /etc/shells"
      warning "  sudo chsh -s $ZSH_PATH \"\$USER\""
      warning "  getent passwd \"\$USER\""
      warning "Then log out and back in to use the new shell."
    fi
  fi
fi
