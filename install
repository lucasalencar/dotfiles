#!/bin/bash

PROFILE=$1 # Requires a profile (e.g. mac-personal, mac-work, homelab)
export DOTFILES_ROOT=$(pwd -P)

source "$DOTFILES_ROOT/print_helper"
source "$DOTFILES_ROOT/helpers"

install_package() {
  local package="$1"

  if [ -f "$DOTFILES_ROOT/$package/install" ]; then
    run_optional_step "Installing package $package" "$DOTFILES_ROOT/$package/install"
  fi
}

setup_package() {
  local package="$1"

  if [ -f "$DOTFILES_ROOT/$package/setup" ]; then
    run_optional_step "Setting up package $package" "$DOTFILES_ROOT/$package/setup"
  fi
}

install_profile() {
  local profile=$1

  if [ ! -f "$DOTFILES_ROOT/profiles/$profile" ]; then
    fail "Profile \"$profile\" not found. Available: $(ls "$DOTFILES_ROOT/profiles" | tr '\n' ' ')"
  fi

  # Exposed to per-package install scripts (e.g. mac-apps/Brewfile guards)
  export DOTFILES_PROFILE="$profile"

  info "Installing packages from \"$profile\" profile"
  while IFS= read -r -u 3 package || [ -n "$package" ]; do
    # Skip blank lines and comments
    case "$package" in
      ''|'#'*) continue ;;
    esac
    install_package "$package"
    setup_package "$package"
  done 3< "$DOTFILES_ROOT/profiles/$profile"
  unset package

  # Save installation profile to load rc files
  echo "$profile" > "$DOTFILES_ROOT/.current_profile"
}

if [ -z "$PROFILE" ]; then
  fail "Usage: ./install <profile>. Available: $(ls "$DOTFILES_ROOT/profiles" | tr '\n' ' ')"
fi

# On Linux, base tools must exist before Homebrew does. The initial
# packages (git, zsh) apt-provide their own binaries when brew is
# missing; their full brew install runs again in the profile loop below.
if is_linux; then
  for bootstrap_package in git zsh; do
    install_package "$bootstrap_package"
  done
  unset bootstrap_package
fi

run_optional_step "Initializing Git setup" "$DOTFILES_ROOT/git/pre-setup"

run_required_step "Installing homebrew" "$DOTFILES_ROOT/homebrew/install"

# homebrew/install runs in a subshell — load brew into THIS shell too
ensure_brew_env

# stow is a dependency of the install mechanism itself (every setup uses
# it), not of any single package. Brew exists on both OSes at this point.
if ! command_exists stow; then
  run_required_step "Installing stow" brew install stow
fi

install_profile "$PROFILE"

success 'All done! :D'
