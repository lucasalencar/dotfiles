#!/bin/bash
# agent-notify: A generic notification wrapper for AI agents (Gemini, Claude, etc.)
# Usage: <json_input> | agent-notify "Agent Name" ["fallback message"]
# The fallback message is used when the stdin JSON has no .message field
# (e.g. for Stop, PreToolUse hooks that don't carry a notification message).

AGENT_NAME="$1"
FALLBACK_MSG="$2"
ALLOW_AGENT_ID="${3:-}"

if [ -z "$AGENT_NAME" ]; then
  echo "agent-notify: missing agent name argument" >&2
  exit 1
fi

INPUT=$(cat)

TYPE=$(echo "$INPUT" | jq -r '.notification_type // empty')

# Skip auth success or other noise
[ "$TYPE" = "auth_success" ] && exit 0

# Skip notifications originating from inside a subagent (Task tool) call.
# AskUserQuestion hooks opt in because Claude Code now includes agent_id on
# interactive input requests from the main session as well.
AGENT_ID=$(echo "$INPUT" | jq -r '.agent_id // empty')
[ -n "$AGENT_ID" ] && [ "$ALLOW_AGENT_ID" != "--allow-agent-id" ] && exit 0

MSG=$(echo "$INPUT" | jq -r ".message // empty")
[ -z "$MSG" ] && MSG="$FALLBACK_MSG"
[ -z "$MSG" ] && exit 0

WIN=$(tmux display-message -t "$TMUX_PANE" -p "#{session_name}:#{window_index}" 2>/dev/null)
WINDOW_ID=$(tmux display-message -t "$TMUX_PANE" -p "#{window_id}" 2>/dev/null)
WINDOW_NAME=$("$DOTFILES_ROOT/tmux/scripts/tmux-window-label" "$WINDOW_ID" 2>/dev/null)
SESSION=$(echo "$WIN" | cut -d: -f1)

# Skip notification if the terminal window actually showing this agent's tmux
# session is frontmost and its active window is the one the agent runs in.
# Terminal window titles are set to the tmux session name (set-titles-string
# "#S" in tmux.conf), so we match on that instead of relying on this script's
# own inherited $TMUX context, which only reflects the agent's own session
# and says nothing about which session/window is actually on screen — this
# matters once multiple tmux sessions are in play, including ones with no
# attached client at all.
TERMINAL_APP_NAME="${TERMINAL_APP_NAME:-ghostty}"
IS_TERMINAL_FOCUSED=$(osascript -e "tell application \"System Events\" to frontmost of application process \"$TERMINAL_APP_NAME\"" 2>/dev/null)
if [ "$IS_TERMINAL_FOCUSED" = "true" ]; then
  FRONT_WINDOW_TITLE=$(osascript -e "tell application \"System Events\" to tell process \"$TERMINAL_APP_NAME\" to get name of front window" 2>/dev/null)
  if [ "$FRONT_WINDOW_TITLE" = "$SESSION" ]; then
    AGENT_PANE_WIN=$(tmux display-message -t "$TMUX_PANE" -p "#{window_id}" 2>/dev/null)
    ACTIVE_WIN=$(tmux display-message -t "$SESSION" -p "#{window_id}" 2>/dev/null)
    [ -n "$AGENT_PANE_WIN" ] && [ "$AGENT_PANE_WIN" = "$ACTIVE_WIN" ] && exit 0
  fi
fi

PROJECT=$(basename "$PWD")
GROUP_ID="tmux-window-$(echo "$WIN" | tr ':' '-')"
TITLE="$AGENT_NAME - $PROJECT"
[ -n "$WINDOW_NAME" ] && TITLE="$TITLE ($WINDOW_NAME)"
notify-macos "$TITLE" "$MSG" "tmux select-window -t '$WIN'" "$GROUP_ID" "$SESSION" &
