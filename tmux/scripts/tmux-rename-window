#!/usr/bin/env bash
# Opens command-prompt pre-filled with the canonical tmux window name.

window_id="${1:?usage: tmux-rename-window <window_id>}"
script_dir="$(cd "$(dirname "$0")" && pwd)"

current=$(tmux display-message -p -t "$window_id" '#{window_name}')

tmux command-prompt -I "$current" -p "Window name (empty resets to directory):" \
  "run-shell -b \"$script_dir/tmux-set-window-name '$window_id' '#{pane_current_path}' '%%'\""
