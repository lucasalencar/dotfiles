#!/usr/bin/env bash

set -u

window_id="${1:?usage: tmux-set-window-name <window_id> <path> <name>}"
path="${2:-}"
name="${3:-}"

if [ -n "$name" ]; then
  tmux rename-window -t "$window_id" "$name"
fi

# `rename-window` disables automatic renaming. Turn it back on so the name
# follows the active pane's directory after the next path change.
tmux set-window-option -t "$window_id" automatic-rename on
tmux refresh-client -S 2>/dev/null || true
