{
  "$schema": "https://opencode.ai/config.json",

  // mac-personal: full config (tmux + context7 + playwright + gmail via taylorwilsdon).
  // Machine paths stay in ~/.config/opencode/opencode.json (written by `tama setup opencode`).

  "keybinds": {
    "input_newline": "ctrl+j,shift+enter"
  },

  "autoshare": false,
  "autoupdate": true,

  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow"
    }
  },

  "mcp": {
    "servers": {
      "tmux": {
        "type": "local",
        "command": ["npx", "-y", "--registry=https://registry.npmjs.org/", "tmux-mcp", "--shell-type=zsh"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth"
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      // Machine-local secret: stored in ~/.secrets/home-assistant-mcp-url (0600, never commit it).
      "home-assistant": {
        "type": "remote",
        "url": "{file:~/.secrets/home-assistant-mcp-url}"
      },
      // Gmail via taylorwilsdon/google_workspace_mcp (workspace-mcp on PyPI).
      // Full access (read/label/move/delete/send) through a local server using
      // your own OAuth client. Needs: uv, GOOGLE_OAUTH_CLIENT_ID/SECRET in env
      // (~/.zshrc.local), Gmail API enabled. First run authenticates in browser.
      "gmail-taylorwilsdon": {
        "type": "local",
        "command": ["uvx", "workspace-mcp", "--tools", "gmail", "--tool-tier", "core"],
        "environment": {
          "GOOGLE_OAUTH_CLIENT_ID": "{env:GOOGLE_OAUTH_CLIENT_ID}",
          "GOOGLE_OAUTH_CLIENT_SECRET": "{env:GOOGLE_OAUTH_CLIENT_SECRET}"
        }
      }
    }
  }
}
