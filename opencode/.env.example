# Example environment for the opencode package.
#
# Real values live OUTSIDE the repo and are never committed:
#   - shell env below -> put them in ~/.zshrc.local (sourced by .zshrc)
#   - file secret     -> ~/.secrets/home-assistant-mcp-url (chmod 0600)

# Gmail MCP (taylorwilsdon/google_workspace_mcp via `uvx workspace-mcp`).
# Bring your own Google Cloud OAuth client with the Gmail API enabled.
# First run authenticates in a browser.
# Consumed by opencode.mac-personal.jsonc (active) and
# opencode.coding-sandbox.jsonc (disabled by default: OAuth needs a local
# browser, unavailable over SSH).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Home Assistant MCP is NOT an env var: every profile reads it from a file.
# Write the full MCP server URL there, one line, then chmod 0600:
#   printf '%s' '<server-url>' > ~/.secrets/home-assistant-mcp-url
#   chmod 0600 ~/.secrets/home-assistant-mcp-url
