{
  "$schema": "https://opencode.ai/config.json",

  // homelab (Proxmox): tmux only — no browser for playwright or context7 OAuth over SSH.
  // Machine paths stay in ~/.config/opencode/opencode.json (written by `tama setup opencode`).

  "keybinds": {
    "input_newline": "ctrl+j,shift+enter"
  },

  "autoshare": false,
  "autoupdate": true,

  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow"
    }
  },

  "mcp": {
    "servers": {
      "tmux": {
        "type": "local",
        "command": ["npx", "-y", "--registry=https://registry.npmjs.org/", "tmux-mcp", "--shell-type=zsh"]
      },
      // Machine-local secret: set HOME_ASSISTANT_MCP_URL on each machine, never commit it.
      "home-assistant": {
        "type": "remote",
        "url": "{env:HOME_ASSISTANT_MCP_URL}"
      }
    }
  }
}
