{
  "$schema": "https://opencode.ai/config.json",

  // coding-sandbox: tmux + playwright — no context7 (OAuth needs a local browser, unavailable over SSH).
  // gmail (taylorwilsdon) included but disabled by default (same OAuth-over-SSH reason).
  // Machine paths stay in ~/.config/opencode/opencode.json (written by `tama setup opencode`).

  "keybinds": {
    "input_newline": "ctrl+j,shift+enter"
  },

  "autoshare": false,
  "autoupdate": true,

  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow"
    }
  },

  "mcp": {
    "servers": {
      "tmux": {
        "type": "local",
        "command": ["npx", "-y", "--registry=https://registry.npmjs.org/", "tmux-mcp", "--shell-type=zsh"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      // Machine-local secret: stored in ~/.secrets/home-assistant-mcp-url (0600, never commit it).
      "home-assistant": {
        "type": "remote",
        "url": "{file:~/.secrets/home-assistant-mcp-url}"
      },
      // Gmail via taylorwilsdon/google_workspace_mcp (workspace-mcp on PyPI).
      // Disabled over SSH by default; needs uv + GOOGLE_OAUTH_CLIENT_ID/SECRET in env.
      "gmail-taylorwilsdon": {
        "type": "local",
        "command": ["uvx", "workspace-mcp", "--tools", "gmail", "--tool-tier", "core"],
        "environment": {
          "GOOGLE_OAUTH_CLIENT_ID": "{env:GOOGLE_OAUTH_CLIENT_ID}",
          "GOOGLE_OAUTH_CLIENT_SECRET": "{env:GOOGLE_OAUTH_CLIENT_SECRET}"
        },
        "disabled": true
      }
    }
  }
}
