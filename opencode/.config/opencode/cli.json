{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "monokai"
  },
  "keybinds": {
    "input.newline": "Shift+Enter",
    "session.tab.next": ["ctrl+tab", "alt+down", "’"],
    "session.tab.previous": ["ctrl+shift+tab", "alt+up", "”"]
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "editor": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "acceleration": false
  }
}
