{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "{HOME}/.dotfiles/opencode/.config/opencode/plugins/tmux-agent-status.ts"
  ],

  "keybinds": {
    "input_newline": "ctrl+j,shift+enter"
  },

  "autoshare": false,
  "autoupdate": true,

  "mcp": {
    "tmux": {
      "type": "local",
      "command": ["npx", "-y", "--registry=https://registry.npmjs.org/", "tmux-mcp", "--shell-type=zsh"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
