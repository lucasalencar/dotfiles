{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "sonnet[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code SessionStart >/dev/null 2>&1 || :"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code UserPromptSubmit >/dev/null 2>&1 || :"
          },
          {
            "type": "command",
            "command": "tmux-agent-state running 'Claude Code'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-state waiting 'Claude Code'"
          },
          {
            "type": "command",
            "command": "tmux-notify-window"
          },
          {
            "type": "command",
            "command": "agent-notify 'Claude Code' 'asked a question' --allow-agent-id"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "clojure-lint-hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code PostToolUse >/dev/null 2>&1 || :"
          },
          {
            "type": "command",
            "command": "tmux-agent-state running 'Claude Code'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code PostToolUseFailure >/dev/null 2>&1 || :"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code PermissionRequest >/dev/null 2>&1 || :"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code Notification >/dev/null 2>&1 || :"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "tmux-agent-state waiting 'Claude Code'"
          },
          {
            "type": "command",
            "command": "tmux-notify-window"
          },
          {
            "type": "command",
            "command": "jq -c '. + {message: \"waiting for your input\"}' | agent-notify 'Claude Code'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code Stop >/dev/null 2>&1 || :"
          },
          {
            "type": "command",
            "command": "tmux-agent-state idle 'Claude Code'"
          },
          {
            "type": "command",
            "command": "tmux-notify-window"
          },
          {
            "type": "command",
            "command": "agent-notify 'Claude Code' 'done'"
          },
          {
            "type": "command",
            "command": "cp -f ~/.claude/settings.json ~/.dotfiles/claude-code/.claude/settings.json"
          },
          {
            "type": "command",
            "command": "cp -f ~/.claude/.mcp.json ~/.dotfiles/claude-code/.claude/.mcp.json 2>/dev/null || true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code StopFailure >/dev/null 2>&1 || :"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code SubagentStart >/dev/null 2>&1 || :"
          },
          {
            "type": "command",
            "command": "tmux-agent-state subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code SubagentStop >/dev/null 2>&1 || :"
          },
          {
            "type": "command",
            "command": "tmux-agent-state subagent-stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(tmux show -gqv @tama_bin 2>/dev/null)\" hook claude-code SessionEnd >/dev/null 2>&1 || :"
          },
          {
            "type": "command",
            "command": "tmux-agent-state clear"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/lucas.alencar/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "glean-mcp@nubank-ai-agents-plugins": true,
    "isa@nubank-ai-agents-plugins": true,
    "pyright-lsp@claude-plugins-official": true,
    "isa@nubank-ai-agents-plugins-tmp": true,
    "isa@nubank-ai-agents-plugins-eng": true,
    "atlassian-mcp@nubank-ai-agents-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "codex@openai-codex": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "nubank-ai-agents-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:nubank/ai-agents-plugins.git"
      },
      "autoUpdate": true
    },
    "nubank-ai-agents-plugins-tmp": {
      "source": {
        "source": "git",
        "url": "git@github.com:nubank/ai-agents-plugins-tmp.git"
      }
    },
    "nubank-ai-agents-plugins-eng": {
      "source": {
        "source": "git",
        "url": "git@github.com:nubank/ai-agents-plugins-eng.git"
      }
    },
    "nubank-ai-agents-plugins-product": {
      "source": {
        "source": "git",
        "url": "git@github.com:nubank/ai-agents-plugins-product.git"
      }
    },
    "nubank-ai-agents-plugins-analytics": {
      "source": {
        "source": "git",
        "url": "git@github.com:nubank/ai-agents-plugins-analytics.git"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
